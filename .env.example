# All optional. Copy to .env.local (git-ignored). Never commit real values.

# Supabase: enables Account, cloud sync and the admin content-review page.
# Use the anon / publishable key only, NEVER the service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Groq: server-only key for /api/ask (Ask Islam, cloud mode).
# Set this in Vercel -> Settings -> Environment Variables. It must NOT start with VITE_.
GROQ_API_KEY=
